          "name": "Upload pre-keys",
          "request": {
            "name": "Upload pre-keys",
            "description": {
              "content": "Uploads a batch of pre-keys, a signed pre-key, and optionally a last-resort Kyber pre-key for the authenticated device. These keys are used by other clients to establish Signal Protocol sessions.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "keys"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"preKeys\": [\n    {\n      \"keyId\": \"<long>\",\n      \"publicKey\": \"<string>\"\n    },\n    {\n      \"keyId\": \"<long>\",\n      \"publicKey\": \"<string>\"\n    }\n  ],\n  \"signedPreKey\": {\n    \"keyId\": \"<long>\",\n    \"publicKey\": \"<string>\",\n    \"signature\": \"<string>\"\n  },\n  \"pqPreKeys\": [\n    {\n      \"keyId\": \"<long>\",\n      \"publicKey\": \"<string>\",\n      \"signature\": \"<string>\"\n    },\n    {\n      \"keyId\": \"<long>\",\n      \"publicKey\": \"<string>\",\n      \"signature\": \"<string>\"\n    }\n  ],\n  \"pqLastResortPreKey\": {\n    \"keyId\": \"<long>\",\n    \"publicKey\": \"<string>\",\n    \"signature\": \"<string>\"\n  }\n}",
