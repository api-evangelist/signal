        {
          "id": "d1d7f609-6783-435e-9c54-c1b0a537935f",
          "name": "Get pre-key bundle for a device",
          "request": {
            "name": "Get pre-key bundle for a device",
            "description": {
              "content": "Retrieves a pre-key bundle for a specific device belonging to the identified account. The bundle includes a pre-key, signed pre-key, and identity key needed to establish a Signal Protocol session.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "keys",
                ":identifier",
                ":deviceId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "identifier",
                  "description": "(Required) The UUID or phone number identifying the target account."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<long>",
                  "key": "deviceId",
                  "description": "(Required) The numeric device identifier. Device 1 is always the primary device."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
