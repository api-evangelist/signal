          "request": {
            "name": "Send an encrypted message",
            "description": {
              "content": "Sends one or more encrypted messages to the specified destination account identified by UUID. Messages are encrypted using the Signal Protocol and include envelope metadata for delivery. The server routes messages to the recipient's devices.",
