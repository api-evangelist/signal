      "name": "Certificates",
      "description": {
        "content": "Certificate endpoints for retrieving delivery certificates used in sealed sender message delivery.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "8d107b68-4914-4f41-9ed8-e70e81228ae8",
          "name": "Get a sealed sender delivery certificate",
          "request": {
            "name": "Get a sealed sender delivery certificate",
            "description": {
              "content": "Returns a delivery certificate for the authenticated account. This certificate is used in sealed sender message delivery, which hides the sender's identity from the server during message transmission.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "certificate",
                "delivery"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "includeE164",
                  "value": "true",
                  "description": "Whether to include the E164 phone number in the certificate."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "f2b8335c-9037-41fc-8b11-87782cf40131",
              "name": "Delivery certificate returned successfully",
              "originalRequest": {
                "url": {
                  "path": [
                    "v1",
                    "certificate",
                    "delivery"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
