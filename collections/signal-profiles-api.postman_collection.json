            "description": {
              "content": "Retrieves the profile for the specified account, including the encrypted profile name, avatar URL, identity key, and capabilities. Profile data is encrypted with the profile key shared between contacts.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "profile",
                ":identifier"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "identifier",
                  "description": "(Required) The UUID identifying the target account."
