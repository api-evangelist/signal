          "name": "Remove a linked device",
          "request": {
            "name": "Remove a linked device",
            "description": {
              "content": "Removes a linked device from the authenticated account. This unlinks the device and invalidates its credentials.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "devices",
                ":deviceId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<long>",
                  "key": "deviceId",
                  "description": "(Required) The numeric device identifier. Device 1 is always the primary device."
                }
              ]
            },
            "method": "DELETE",
            "auth": null
